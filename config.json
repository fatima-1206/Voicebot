{
  "docker":true,
  "CELERY_BROKER_URL": "redis://localhost:6379/0",
  "CELERY_RESULT_BACKEND": "redis://localhost:6379/1",
  "sample_rate": 16000,
  "block_duration": 0.5,
  "min_chunk_duration": 2,
  "max_chunk_duration": 20,
  "silence_threshold": -35,
  "max_silence_duration": 0.7,
  "channels": 1,
  "language": "en",
  "device": "auto",
  "model_size": {
    "cpu": "medium",
    "cuda": "large-v2"
  },
  "compute_type": {
    "cpu": "int8",
    "cuda": "int8_float16"
  },
  "bm25Weight": 0.3,
  "faissWeight": 0.6,
  "mt5_model_id": {
    "cpu": "google/mt5-base",
    "cuda": "google/mt5-large"
  },
  "bloom_model_id": {
    "cpu": "bigscience/bloom-560m",
    "cuda": "bigscience/bloom-1b1"
  },
   "flan_model_id": {
    "cpu": "google/flan-t5-base",
    "cuda": "google/flan-t5-large"
  },
  "mistral_model_id": {
    "cpu": "bigscience/bloom-560m",
    "cuda": "mistralai/Mistral-7B-Instruct-v0.2"
  },
  
  "max_new_tokens": 100,
  "max_input_tokens": 1012,
  "temperature": 0.7,

  "reranker_model_id": "BAAI/bge-reranker-base",
  "multilingual_reranker_model_id": "BAAI/bge-m3",

  "groq_tts": {
    "model": "playai-tts",
    "response_format": "wav",
    "voices": {
      "en": "Fritz-PlayAI",
      "ur": "Fritz-PlayAI"
    },
    "default_voice": "Fritz-PlayAI"
  }
}


